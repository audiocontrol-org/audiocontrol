{
  "name": "@audiocontrol/roland-sxx0-editor",
  "version": "0.1.0",
  "description": "Web-based editor for Roland S-series samplers (S-330, S-550)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp ../../netlify/roland-sxx0-editor/_redirects ../../netlify/roland-sxx0-editor/_headers dist/",
    "build:deploy": "cd ../.. && pnpm install --frozen-lockfile && make",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration",
    "test:runbook:tier3-drop-smoke": "tsx scripts/runbook-tier3-drop-smoke.ts",
    "test:runbook:live": "tsx scripts/runbook-live.ts",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:device": "tsx scripts/validate-device.ts",
    "test:e2e:hardware": "./scripts/run-hardware-e2e.sh",
    "test:e2e:http-midi": "./scripts/run-http-midi-e2e.sh",
    "test:e2e:s550-conformance": "E2E_DEVICE_TYPE=s550 PLAYWRIGHT_CONFIG=playwright.s550-conformance.config.ts ./scripts/run-http-midi-e2e.sh",
    "test:e2e:library": "./scripts/run-library-e2e.sh",
    "test:e2e:device-library": "./scripts/run-device-library-e2e.sh",
    "test:e2e:loop-editor": "./scripts/run-loop-editor-e2e.sh",
    "test:e2e:sample-chopper": "./scripts/run-sample-chopper-e2e.sh",
    "test:e2e:sample-editor": "./scripts/run-sample-editor-e2e.sh",
    "visual:capture": "playwright test -c playwright.visual.config.ts",
    "visual:compare": "node ../../scripts/visual-compare.mjs .",
    "visual:baseline:update": "node ../../scripts/visual-update-baseline.mjs ."
  },
  "keywords": [
    "roland",
    "s-330",
    "s-550",
    "sampler",
    "midi",
    "sysex",
    "web-midi",
    "editor"
  ],
  "author": "Orion Letizi",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/audiocontrol-org/audiocontrol.git",
    "directory": "modules/roland-sxx0-editor"
  },
  "dependencies": {
    "@audiocontrol/editor-core": "workspace:*",
    "@audiocontrol/loop-editor": "workspace:*",
    "@audiocontrol/midi-core": "workspace:*",
    "@audiocontrol/sample-chopper": "workspace:*",
    "@audiocontrol/sample-editor": "workspace:*",
    "@audiocontrol/sampler-devices": "workspace:*",
    "@audiocontrol/sampler-library": "workspace:*",
    "@audiocontrol/synth-core": "workspace:*",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@tanstack/react-query": "^5.17.0",
    "clsx": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "tailwind-merge": "^2.2.0",
    "yaml": "^2.7.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@audiocontrol/e2e-infra": "workspace:*",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/webmidi": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "easymidi": "^3.1.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.10",
    "vite-plugin-mkcert": "^1.17.9",
    "vitest": "^1.1.0"
  }
}
