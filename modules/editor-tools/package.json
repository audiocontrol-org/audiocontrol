{
  "name": "@audiocontrol/editor-tools",
  "version": "0.1.0",
  "description": "Shared tools for audiocontrol editors - build info, log capture, debugging",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "audiocontrol",
    "editor",
    "debug",
    "build-info"
  ]
}
