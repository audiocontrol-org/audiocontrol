{
  "name": "@audiocontrol/jv1080-editor",
  "version": "0.1.0",
  "description": "Web-based editor scaffold for Roland JV-1080",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "roland",
    "jv-1080",
    "synthesizer",
    "midi",
    "sysex",
    "web-midi",
    "editor"
  ],
  "author": "Orion Letizi",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/audiocontrol-org/audiocontrol.git",
    "directory": "modules/jv1080-editor"
  },
  "dependencies": {
    "@audiocontrol/editor-core": "workspace:*",
    "@audiocontrol/editor-tools": "workspace:*",
    "@audiocontrol/sampler-devices": "workspace:*",
    "@audiocontrol/shared-midi": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/webmidi": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.3.0",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  }
}
