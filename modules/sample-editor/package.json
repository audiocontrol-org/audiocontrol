{
  "name": "@audiocontrol/sample-editor",
  "version": "0.1.0",
  "description": "Sample editing operations: trim, normalize, fade, reverse with undo/redo support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config dev/vite.config.ts",
    "build": "pnpm test && tsup",
    "build:lib": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "author": "Orion Letizi",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/audiocontrol-org/audiocontrol.git",
    "directory": "modules/sample-editor"
  },
  "dependencies": {
    "@audiocontrol/synth-core": "workspace:*",
    "@audiocontrol/sampler-library": "workspace:*",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@radix-ui/react-dialog": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@audiocontrol/editor-core": "workspace:^",
    "@radix-ui/react-dialog": "^1.0.5",
    "@tsconfig/recommended": "^1.0.8",
    "@types/node": "^22.13.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vite": "^5.0.10",
    "vite-plugin-mkcert": "^1.17.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.2.0",
    "yaml": "^2.8.2"
  }
}
