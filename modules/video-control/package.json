{
  "name": "@audiocontrol/video-control",
  "version": "0.1.0",
  "description": "Automated demo video generation from scripted Playwright browser interactions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "test": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "author": "Orion Letizi",
  "license": "Apache-2.0",
  "dependencies": {
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.7.3",
    "vitest": "^1.2.0"
  }
}
