#!/usr/bin/env bash
# .githooks/commit-msg — invoked by `git commit` with the commit message
# file path as $1. Fires the refactor-preconditions gate when the message
# claims to close one or more clones.yaml entries.
#
# Why commit-msg (and not pre-commit): pre-commit hooks don't have
# access to the commit message; the commit message file is only fully
# resolved at the commit-msg stage. Pulling this out of pre-commit lets
# the message-driven gate live next to the other repo hooks without
# poking at .git/COMMIT_EDITMSG from a pre-commit script (which is
# tighter coupling to git internals than we need).
#
# Activated via `make install-hooks` (sets core.hooksPath = .githooks).
# The hook script itself is tracked, so it travels across clones; the
# core.hooksPath setting lives in .git/config (not tracked) so each
# clone runs `make install-hooks` once.
#
# Workplan T5.3.

set -euo pipefail

msg_file="$1"

if grep -qiE '^[[:space:]]*Closes[[:space:]]+clones\.yaml[[:space:]]+' "$msg_file"; then
  echo "commit-msg: refactor marker detected; running check-refactor-preconditions..."
  # Run the gate as a child process (not exec'd) so the marker-write below
  # still runs on the success path. set -e fails the hook if the gate fails,
  # which aborts the commit before the marker is written — preserving the
  # bypass-detection contract.
  make --no-print-directory check-refactor-preconditions COMMIT_MSG_FILE="$msg_file"
fi

# VISUAL-VERIFICATION.md gate. Fires when staged files include any UI
# source (modules/<editor>/src/**/*.{tsx,jsx,css,scss}). Requires the
# commit message to carry a `Visual-verify:` marker (route list or
# `skipped-<substantive-reason>` form). Same lifecycle-slot semantics
# as the refactor-preconditions check above: gate runs as a child
# process so the marker write at the bottom of this hook still fires
# on the success path; a non-zero exit aborts the commit before the
# marker write.
if git diff --cached --name-only --diff-filter=ACM \
     | grep -qE '^modules/[^/]+-editor/src/.*\.(tsx|jsx|css|scss)$'; then
  echo "commit-msg: UI source staged; running check-visual-verify..."
  make --no-print-directory check-visual-verify COMMIT_MSG_FILE="$msg_file"
fi

# T7.5 marker-write (moved here per AUDIT-20260522-03). This MUST be the
# last successful action of commit-msg. Architectural rationale:
#
#   - commit-msg runs AFTER pre-commit succeeds (Git lifecycle: pre-commit
#     → prepare-commit-msg → commit-msg → atomic commit → post-commit).
#   - commit-msg is itself SKIPPED by `git commit --no-verify`, same as
#     pre-commit, so a bypassed commit never reaches this line.
#   - Between commit-msg's success exit and post-commit's execution the
#     commit lands atomically — Git provides no abort window in which a
#     written marker could be stranded for a later commit to inherit.
#
# The only way for the marker to exist when post-commit runs is for
# commit-msg to have completed, which means both pre-commit and
# commit-msg ran and `--no-verify` was not used. See .githooks/post-commit
# for the rationale on --git-common-dir vs --git-path.
SENTINEL_DIR="$(git rev-parse --git-common-dir)/hooks-sentinels"
mkdir -p "$SENTINEL_DIR"
: > "$SENTINEL_DIR/.pre-commit-marker"
