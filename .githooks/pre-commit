#!/usr/bin/env bash
# Pre-commit hook — tracked in-repo so it travels across clones,
# worktrees, and dev environments. Per-clone activation:
#
#     make install-hooks
#
# which runs `git config core.hooksPath .githooks` once for that
# clone (the config setting itself isn't tracked; it lives in
# `.git/config`).
#
# Gate added 2026-05-19 after a CSS-duplication refactor blew up
# the UI: I built the entire editor with cross-page chrome
# duplicated and nobody caught it until visual review. This hook
# blocks NEW duplication at commit time. Pre-existing pairs are
# catalogued in `tools/check-css-duplication.expected.txt` and
# don't block; they're tracked as backlog work.
#
# AUDIT-20260524-10 (TF-004) restructure: previously this hook ran
# `set -e` and aborted on the FIRST failing gate. For substantial
# commits (primitive promotion, multi-module refactor) where multiple
# gates may fail independently, that cost N commit attempts — operator
# fixed one gate, hit the next, fixed it, hit the next, etc.
#
# New shape (default): each gate's exit code + combined output is
# captured to a per-gate log under a `mktemp -d` directory. AFTER
# every applicable gate has run, a consolidated report names every
# PASS + every FAIL with the failure's captured output indented under
# its FAIL line. If any gate failed, the hook exits non-zero and the
# AUDIT-03 commit-msg marker write never fires (because the commit
# aborts before commit-msg runs).
#
# Gates that don't trigger (e.g., CSS-only gates with no .css files
# staged) do not appear in the report at all — only ran-and-passed
# and ran-and-failed gates appear.
#
# Opt-in fast-fail: set PRE_COMMIT_SHORT_CIRCUIT=1 to restore the
# previous short-circuit behavior for tight iteration loops. First
# failing gate prints its output (live, un-captured) and exits.

set -uo pipefail

PRE_COMMIT_SHORT_CIRCUIT="${PRE_COMMIT_SHORT_CIRCUIT:-0}"

# Detect which staged-file conditions apply so each gate's conditional
# is evaluated once up-front (and consistently between the fast-fail
# and consolidated paths). Both checks tolerate the empty-diff case
# (initial commit etc.) by treating the grep miss as "no files match".
STAGED_NAMES="$(git diff --cached --name-only --diff-filter=ACM || true)"
HAS_CSS=0
HAS_TS=0
HAS_CLONES_YAML=0
HAS_EDITOR_CORE_CSS_OR_PKG=0
if printf '%s\n' "$STAGED_NAMES" | grep -qE '\.(css|scss)$'; then
  HAS_CSS=1
fi
if printf '%s\n' "$STAGED_NAMES" | grep -qE '\.tsx?$'; then
  HAS_TS=1
fi
if printf '%s\n' "$STAGED_NAMES" | grep -qxF 'docs/scope-discovery/clones.yaml'; then
  HAS_CLONES_YAML=1
fi
# akai-harmonization workplan task 2.9 — fire the editor-core CSS-
# exports gate when either side of the pairing is staged: a new/edited
# CSS file under modules/editor-core/src/design/ OR a change to
# modules/editor-core/package.json. The CSS-only check above also
# fires on the design dir but does not invoke this specific gate;
# the package.json case below is the one this conditional uniquely
# covers (package.json is not a `.css`/`.scss` file, so HAS_CSS=0
# when only the exports block changes).
if printf '%s\n' "$STAGED_NAMES" | grep -qE '^modules/editor-core/src/design/[^/]+\.css$'; then
  HAS_EDITOR_CORE_CSS_OR_PKG=1
fi
if printf '%s\n' "$STAGED_NAMES" | grep -qxF 'modules/editor-core/package.json'; then
  HAS_EDITOR_CORE_CSS_OR_PKG=1
fi
# akai-harmonization workplan task 2.10 — fire the tab-active-state
# sync gate when either side of the pairing is staged: the YAML
# registry that drives the codegen OR the generated CSS file. The
# CSS-only check above also fires on the generated CSS but does not
# invoke this specific gate; the YAML case below is the one this
# conditional uniquely covers (the registry is a `.yaml` file, so
# HAS_CSS=0 when only the registry changes).
HAS_TAB_GROUPS_REGISTRY_OR_CSS=0
if printf '%s\n' "$STAGED_NAMES" | grep -qxF 'docs/scope-discovery/tab-groups.yaml'; then
  HAS_TAB_GROUPS_REGISTRY_OR_CSS=1
fi
if printf '%s\n' "$STAGED_NAMES" | grep -qxF 'modules/roland-sxx0-editor/src/styles/tab-active-state.css'; then
  HAS_TAB_GROUPS_REGISTRY_OR_CSS=1
fi
# Source-side companion gate (Gate B). Fires when staged changes
# touch any .tsx/.html file under the production scan surface OR the
# registry itself. The .tsx case is covered by HAS_TS above; .html
# files do not match the .tsx? pattern, so we add a dedicated
# condition. The registry case is already covered by
# HAS_TAB_GROUPS_REGISTRY_OR_CSS — re-scan whenever the registered
# ID set could have changed.
HAS_TAB_GROUPS_SOURCES_CHANGED=0
if [ "$HAS_TS" = "1" ]; then
  HAS_TAB_GROUPS_SOURCES_CHANGED=1
fi
if printf '%s\n' "$STAGED_NAMES" | grep -qE '\.html$'; then
  HAS_TAB_GROUPS_SOURCES_CHANGED=1
fi
if [ "$HAS_TAB_GROUPS_REGISTRY_OR_CSS" = "1" ]; then
  HAS_TAB_GROUPS_SOURCES_CHANGED=1
fi

# -----------------------------------------------------------------------
# Fast-fail path (PRE_COMMIT_SHORT_CIRCUIT=1)
#
# Keeps the prior `set -e` semantics: gates run in declaration order;
# the first non-zero exit aborts the hook. Output is un-captured so
# the operator sees live progress + the failing gate's full output
# inline. Used by developers whose iteration workflow benefits from
# fail-fast (small commits, tight feedback loops).
# -----------------------------------------------------------------------

if [ "$PRE_COMMIT_SHORT_CIRCUIT" = "1" ]; then
  set -e
  if [ "$HAS_CSS" = "1" ]; then
    echo "pre-commit: checking for new cross-page CSS duplication…"
    make --no-print-directory check-css-duplication
    echo "pre-commit: checking for chevron-named classes outside the canonical primitive…"
    make --no-print-directory check-chevron-sizing
  fi
  if [ "$HAS_TS" = "1" ]; then
    echo "pre-commit: checking for new TS/TSX clone groups…"
    make --no-print-directory check-clone-duplication
    echo "pre-commit: checking for anti-pattern matches…"
    make --no-print-directory check-anti-patterns
    echo "pre-commit: checking for adopter-manifest holdouts…"
    make --no-print-directory check-adopters
    echo "pre-commit: checking cross-editor symmetry…"
    make --no-print-directory check-editor-symmetry > /dev/null
  fi
  if [ "$HAS_CLONES_YAML" = "1" ]; then
    # AUDIT-20260524-14 Heavy backstop. Only relevant when the baseline
    # itself is staged — most commits don't touch clones.yaml and pay
    # zero cost for this gate.
    echo "pre-commit: checking clones.yaml disposition-survivor invariant…"
    make --no-print-directory check-disposition-survivor
  fi
  if [ "$HAS_EDITOR_CORE_CSS_OR_PKG" = "1" ]; then
    # akai-harmonization workplan task 2.9 — every src/design/*.css
    # file must have a matching exports entry, and every design-scoped
    # exports entry must point to an existing file. Catches the
    # "promoted a primitive but forgot the exports entry" pathology.
    echo "pre-commit: checking editor-core CSS exports completeness…"
    make --no-print-directory check-editor-core-css-exports
  fi
  if [ "$HAS_TAB_GROUPS_REGISTRY_OR_CSS" = "1" ]; then
    # akai-harmonization workplan task 2.10 — re-run the
    # tab-active-state codegen in --check mode; fails if the on-disk
    # CSS differs from what the registry implies. Catches the silent-
    # drop bug commit d5d99516 named (a tab id added to 3 of 4
    # selector lists silently broke one behavior).
    echo "pre-commit: checking tab-active-state registry/CSS sync…"
    make --no-print-directory check-tab-active-state
  fi
  if [ "$HAS_TAB_GROUPS_SOURCES_CHANGED" = "1" ]; then
    # Source-side companion (Gate B). Scans the production tab-
    # consumer surface for unregistered tab IDs. Catches "added a
    # new AcRadioTabs consumer with id: 'tt-NEW' but forgot to
    # register tt-NEW in the registry."
    echo "pre-commit: checking tab-active-state source-side registrations…"
    make --no-print-directory check-tab-active-state-sources
  fi
  exit 0
fi

# -----------------------------------------------------------------------
# Consolidated path (default)
#
# Each gate's combined stdout+stderr captured to a per-gate log.
# After every applicable gate has run, the consolidated report is
# printed. Any non-zero exit causes the hook to exit 1 (commit
# aborts, commit-msg marker write never fires).
# -----------------------------------------------------------------------

LOG_DIR="$(mktemp -d -t pre-commit-gates.XXXXXX)"
# Cleanup on any exit path. The trap fires on normal exit, error exit,
# and signal-driven exit (HUP/INT/TERM). The temp dir is fully owned
# by this hook invocation — nothing outside this script reads it.
trap 'rm -rf "$LOG_DIR"' EXIT HUP INT TERM

# Parallel arrays tracking gate name + exit code + captured-log path.
# Bash arrays are clumsier than a struct but they keep this hook
# dependency-free (no python/jq/etc.) and the report iteration is
# trivial. Index-aligned: GATE_NAMES[i] / GATE_CODES[i] / GATE_LOGS[i].
GATE_NAMES=()
GATE_CODES=()
GATE_LOGS=()

# run_gate <name> <command...> — runs the command with combined
# stdout+stderr captured to a per-gate log file, records the exit
# code, and appends to the parallel arrays. Does NOT abort on a
# non-zero exit — the consolidated report decides the hook's fate.
run_gate() {
  local name="$1"; shift
  local log="$LOG_DIR/$name.log"
  # Combine stdout+stderr so the captured output mirrors what an
  # interactive operator would see if the gate were running live.
  # `|| true` would mask the exit code; capture it via $? instead.
  local code=0
  "$@" > "$log" 2>&1 || code=$?
  GATE_NAMES+=("$name")
  GATE_CODES+=("$code")
  GATE_LOGS+=("$log")
}

# Mirror the conditional structure of the fast-fail path so gate
# selection is identical between modes. Gates that don't trigger
# don't appear in the consolidated report.
if [ "$HAS_CSS" = "1" ]; then
  run_gate check-css-duplication make --no-print-directory check-css-duplication
  run_gate check-chevron-sizing make --no-print-directory check-chevron-sizing
fi
if [ "$HAS_TS" = "1" ]; then
  run_gate check-clone-duplication make --no-print-directory check-clone-duplication
  run_gate check-anti-patterns make --no-print-directory check-anti-patterns
  run_gate check-adopters make --no-print-directory check-adopters
  run_gate check-editor-symmetry make --no-print-directory check-editor-symmetry
fi
if [ "$HAS_CLONES_YAML" = "1" ]; then
  # AUDIT-20260524-14 Heavy backstop. Pre-commit invariant: no entry
  # silently transitions from a protected disposition to `pending` in
  # the staged diff against HEAD.
  run_gate check-disposition-survivor make --no-print-directory check-disposition-survivor
fi
if [ "$HAS_EDITOR_CORE_CSS_OR_PKG" = "1" ]; then
  # akai-harmonization workplan task 2.9. Pre-commit invariant: every
  # modules/editor-core/src/design/*.css file is exported via
  # modules/editor-core/package.json "exports:", and no design-scoped
  # exports entry points to a missing file.
  run_gate check-editor-core-css-exports make --no-print-directory check-editor-core-css-exports
fi
if [ "$HAS_TAB_GROUPS_REGISTRY_OR_CSS" = "1" ]; then
  # akai-harmonization workplan task 2.10. Pre-commit invariant: the
  # generated tab-active-state.css is byte-identical to a fresh
  # regeneration from docs/scope-discovery/tab-groups.yaml. Catches
  # the silent-drop bug commit d5d99516 named — a tab id added to
  # 3 of 4 selector lists silently broke one behavior while the
  # other 3 kept working.
  run_gate check-tab-active-state make --no-print-directory check-tab-active-state
fi
if [ "$HAS_TAB_GROUPS_SOURCES_CHANGED" = "1" ]; then
  # Gate B companion. Pre-commit invariant: every tab-group ID
  # referenced by production source (modules/**/*.{tsx,ts,html} +
  # the akai-harmonization mockups) is registered in the registry.
  run_gate check-tab-active-state-sources make --no-print-directory check-tab-active-state-sources
fi

# Tally failures + render the consolidated report. Format: failure
# block first (operator-actionable content top-of-screen), pass list
# afterwards. Failure-block stderr is indented by 4 spaces so it's
# visually distinct from the gate headers.
FAILED=0
TOTAL=${#GATE_NAMES[@]}
for code in "${GATE_CODES[@]+"${GATE_CODES[@]}"}"; do
  if [ "$code" -ne 0 ]; then
    FAILED=$((FAILED + 1))
  fi
done

if [ "$TOTAL" -eq 0 ]; then
  # No gates triggered (e.g., commit touches only .md or .png files).
  # Nothing to report; fall through to exit 0.
  exit 0
fi

if [ "$FAILED" -gt 0 ]; then
  echo "pre-commit: $FAILED of $TOTAL gate(s) failed:"
  echo ""
  # FAIL blocks first.
  for i in "${!GATE_NAMES[@]}"; do
    name="${GATE_NAMES[$i]}"
    code="${GATE_CODES[$i]}"
    log="${GATE_LOGS[$i]}"
    if [ "$code" -ne 0 ]; then
      echo "  [FAIL] $name (exit $code):"
      # sed-free indentation: prefix every line of the captured log
      # with 4 spaces. awk handles empty logs gracefully (no output).
      awk '{ print "    " $0 }' "$log"
      echo ""
    fi
  done
  # PASS list after.
  for i in "${!GATE_NAMES[@]}"; do
    name="${GATE_NAMES[$i]}"
    code="${GATE_CODES[$i]}"
    if [ "$code" -eq 0 ]; then
      echo "  [PASS] $name"
    fi
  done
  echo ""
  echo "Fix all failures + re-commit; or set PRE_COMMIT_SHORT_CIRCUIT=1 to fail-fast."
  exit 1
fi

# All gates passed — fall through to the (pre-existing) marker-write
# rationale below. No per-gate logging in the happy path; operators
# who want progress output should set PRE_COMMIT_SHORT_CIRCUIT=1.

# T7.5 (corrected per AUDIT-20260522-03) — the "pre-commit ran to
# completion" marker is intentionally NOT written here. It is written by
# `.githooks/commit-msg` as commit-msg's last successful action.
#
# Why moved: writing the marker from pre-commit leaves a stale-marker hole.
# If pre-commit succeeded but a later hook (e.g., commit-msg's refactor-
# preconditions gate) aborted the commit, the marker survived on disk. A
# subsequent `git commit --no-verify` skipped pre-commit but inherited the
# stale marker, so post-commit falsely recorded the bypassed commit as
# pre-commit-verified. commit-msg runs AFTER pre-commit succeeds AND
# immediately before the commit lands atomically — there is no abort window
# between marker write and post-commit consumption. commit-msg is also
# skipped by `--no-verify`, preserving the bypass-detection property.
