#!/usr/bin/env bash
# Pre-commit hook — tracked in-repo so it travels across clones,
# worktrees, and dev environments. Per-clone activation:
#
#     make install-hooks
#
# which runs `git config core.hooksPath .githooks` once for that
# clone (the config setting itself isn't tracked; it lives in
# `.git/config`).
#
# Gate added 2026-05-19 after a CSS-duplication refactor blew up
# the UI: I built the entire editor with cross-page chrome
# duplicated and nobody caught it until visual review. This hook
# blocks NEW duplication at commit time. Pre-existing pairs are
# catalogued in `tools/check-css-duplication.expected.txt` and
# don't block; they're tracked as backlog work.

set -euo pipefail

# Gates fail-fast in declaration order: CSS first, then TS/TSX clone.
# A commit touching both will surface CSS failures before the TS check
# runs; the developer fixes CSS, commits again, then sees any TS clone
# issues on the second cycle. Acceptable because each gate is fast and
# the two-cycle case is rare in practice; tighten to collect-and-report
# both failures together if that pattern starts costing time.

# Only re-run the CSS check when staged files actually touch CSS.
# Without this, every commit pays the parse cost. The pattern
# matches the stylesheet directories the checker walks.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.(css|scss)$'; then
  echo "pre-commit: checking for new cross-page CSS duplication…"
  make --no-print-directory check-css-duplication
fi

# Only re-run the general TS/TSX clone check when staged files
# actually touch TypeScript. Without this, every commit pays the
# jscpd parse cost. The pattern matches the file extensions
# `.jscpd.json` scans (`typescript` -> `ts`, `tsx`).
if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.tsx?$'; then
  echo "pre-commit: checking for new TS/TSX clone groups…"
  make --no-print-directory check-clone-duplication
fi
